generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SELLER
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}
/// Mirrors Stripe PaymentIntent status values verbatim, including the
/// single-l spelling of CANCELED. Do not "correct" it — the mapping from
/// Stripe must stay a direct uppercase transform with no exceptions.
enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  REQUIRES_ACTION
  PROCESSING
  REQUIRES_CAPTURE
  CANCELED
  SUCCEEDED
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  password   String
  firstName  String?
  lastName   String?
  isEmailVerified Boolean @default(false)
  role       UserRole    @default(CUSTOMER)
  sessions   Session[]
  orders     Order[]
  cartItems  CartItem[]
  reviews    Review[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  @@index([userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  priceCents  Int
  sku         String?     @unique
  stock       Int         @default(0)
  images      String[]
  isActive    Boolean     @default(true)
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  orderItems  OrderItem[]
  cartItems   CartItem[]
  reviews     Review[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@index([isActive])
  @@index([categoryId])
}

model Order {
  id         String       @id @default(uuid())
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  status     OrderStatus  @default(PENDING)
  totalCents Int          @default(0)
  items      OrderItem[]
  paymentAttempts Int @default(0)
  paymentIntentId String?
  payments   Payment[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

model Payment {
  id                    String        @id @default(uuid())
  order                 Order         @relation(fields: [orderId], references: [id])
  orderId               String
  stripePaymentIntentId String        @unique
  // CHECK ("amountCents" > 0) is not expressible in schema.prisma (no
  // @check attribute in this Prisma version) — add it by hand to the
  // migration.sql when the migration is created.
  amountCents           Int
  // VARCHAR(3) is expressible here; the regex format check,
  // CHECK (currency ~ '^[A-Z]{3}$'), is not — add it by hand to the
  // migration.sql when the migration is created.
  currency              String        @db.VarChar(3)
  status                PaymentStatus @default(REQUIRES_PAYMENT_METHOD)
  providerFeeCents      Int?
  // Mirrors Stripe's last_payment_error. Stripe has no FAILED status: a
  // declined attempt reverts the PaymentIntent to REQUIRES_PAYMENT_METHOD,
  // so these are the only record of what the last failure actually was.
  lastFailureCode       String?
  lastFailureMessage    String?
  settledAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  @@index([orderId])
  @@index([status, createdAt])
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED        // retryable: attempts still below the cap
  DEAD_LETTERED // terminal: will not be retried
}

model WebhookEvent {
  id               String    @id @default(uuid())

  // Received facts — what Stripe sent. Immutable forever once written;
  // enforced by a BEFORE UPDATE trigger in the migration, not just by
  // convention. charge.* payloads carry payment_method_details (last4,
  // brand, expiry) — cardholder data under PCI scope. Never log this
  // column; access to it must be access-controlled.
  stripeEventId    String    @unique
  type             String
  payload          Json
  stripeCreatedAt  DateTime
  receivedAt       DateTime  @default(now())

  // Retention policy, not a Stripe fact — writable (e.g. to extend a legal
  // hold), and outside the trigger's lock. 400 days, not a shorter window:
  // a customer can dispute a charge months later, and this event is the
  // evidence for that dispute — destroying it early would remove our own
  // defence. NULL means indefinite retention, not "unset" or a bug.
  expiresAt        DateTime? @default(dbgenerated("((now() AT TIME ZONE 'UTC') + interval '400 days')"))

  // Processing state — mutable, this is what changes as we work the event.
  status           WebhookEventStatus @default(PENDING)
  processedAt      DateTime?
  processingError  String?
  attempts         Int       @default(0)

  // Derived query accessor extracted from payload at write time. payload
  // stays authoritative; this can be recomputed/backfilled independently.
  orderId          String?

  // Load-bearing for the sweep job, not a convenience index: a processing
  // failure returns 2xx to Stripe (so Stripe won't retry it), which moves
  // retry responsibility entirely to us. This index is what makes "find
  // PENDING/FAILED events older than X" a cheap lookup instead of a scan.
  @@index([status, receivedAt])
  @@index([type, receivedAt])
  @@index([orderId])
}

model OrderItem {
  id         String   @id @default(uuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  priceCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([orderId])
  @@index([productId])
}

model CartItem {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([userId, productId])
}

model Review {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([userId])
  @@index([productId])
}
